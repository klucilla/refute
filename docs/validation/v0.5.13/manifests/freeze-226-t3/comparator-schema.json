 "report": [
  {
   "name": "period-row",
   "source": "report.py:217-218",
   "regex": "\\| Period \\(d\\) \\| (?P<found>[^|]*?) \\| (?P<published>[^|]*?) \\|",
   "groups": {
    "found": "measurement",
    "published": "exact"
   }
  },
  {
   "name": "epoch-row",
   "source": "report.py:209-213",
   "regex": "\\| Epoch \\(BJD_TDB\\) \\| (?P<found>[^|]*?) \\| (?P<published>[^|]*?) \\|",
   "groups": {
    "found": "measurement",
    "published": "exact"
   }
  },
  {
   "name": "duration-row",
   "source": "report.py:220-221",
   "regex": "\\| Duration \\(h\\) \\| (?P<found>[^|]*?) \\| (?P<published>[^|]*?) \\|",
   "groups": {
    "found": "measurement",
    "published": "exact"
   }
  },
  {
   "name": "depth-row",
   "source": "report.py:222-223",
   "regex": "\\| Depth \\(ppm\\) \\| (?P<found>[^|]*?) \\| (?P<published>[^|]*?) \\|",
   "groups": {
    "found": "measurement",
    "published": "exact"
   }
  },
  {
   "name": "snr-row",
   "source": "report.py:224",
   "regex": "\\| SNR \\| (?P<found>[^|]*?) \\| \\|",
   "groups": {
    "found": "measurement"
   }
  },
  {
   "name": "relative-period-error",
   "source": "report.py:226-229",
   "regex": "- Relative period error: (?P<rel>\\S+) \\(tolerance (?P<tol>\\S+), within: (?P<within>\\S+), alias: (?P<alias>.*)\\)",
   "groups": {
    "rel": "measurement",
    "tol": "exact",
    "within": "exact",
    "alias": "exact"
   }
  },
  {
   "name": "sde-line",
   "source": "report.py:137-138",
   "regex": "- SDE: (?P<note>.*)\\. SDE of the kept peak \\(largest over sectors\\): (?P<sde>\\S+)\\.",
   "groups": {
    "note": "exact",
    "sde": "measurement"
   }
  },
  {
   "name": "parameters-line",
   "source": "report.py:146-148",
   "regex": "- Period (?P<period>\\S+) d \\(error (?P<period_err>\\S+)\\) and epoch (?P<epoch>\\S+) BJD_TDB \\(error (?P<epoch_err>\\S+)\\), from: (?P<source>.*)\\.",
   "groups": {
    "period": "measurement",
    "period_err": "measurement",
    "epoch": "measurement",
    "epoch_err": "measurement",
    "source": "exact"
   },
   "group_markers": {
    "period_err": [
     "None",
     "nan",
     "inf",
     "-inf"
    ],
    "epoch_err": [
     "None",
     "nan",
     "inf",
     "-inf"
    ],
    "period": [
     "nan",
     "inf",
     "-inf"
    ],
    "epoch": [
     "n/a",
     "nan",
     "inf",
     "-inf"
    ]
   },
   "note": "report.py:146-148 prints the period and the errors with !r (None when the BLS fallback leaves the errors absent, pipeline.py:833-840) and the epoch with _bjd (n/a or repr)"
  },
  {
   "name": "cadence-row",
   "source": "report.py:156-159",
   "regex": "\\| (?P<sector>[0-9]+) \\| (?P<used>[^|]*?) \\| (?P<in_span>[^|]*?) \\| (?P<fraction>[^|]*?) \\|",
   "note": "Codex's round 2, item 3, and decision T2(1): the row is recognized by its structure (a numeric first cell and four cells, empty cells included); the counts (pipeline.py:821-822, int) must be integers and the fraction (:.3f of a float) a finite decimal, or the row fails, equal or not",
   "groups": {
    "sector": "exact",
    "used": "integer",
    "in_span": "integer",
    "fraction": "measurement"
   },
   "group_markers": {
    "used": [],
    "in_span": [],
    "fraction": []
   }
  },
  {
   "name": "holdout-row",
   "source": "report.py:282-285",
   "regex": "\\| (?P<year>[0-9]+) \\| (?P<status>[A-Z_]+) \\| (?P<windows>[^|]*?) \\| (?P<hidden_snr>[^|]*?) \\| (?P<control_snr>[^|]*?) \\|",
   "groups": {
    "year": "exact",
    "status": "exact",
    "windows": "integer",
    "hidden_snr": "measurement",
    "control_snr": "measurement"
   },
   "group_markers": {
    "windows": [
     "n/a"
    ]
   }
  },
  {
   "name": "holdout-v05-row",
   "source": "report.py:296-299",
   "regex": "\\| (?P<year>[0-9]+) \\| (?P<matches>yes|no|n/a) \\| (?P<sigma>[^|]*?) \\|",
   "groups": {
    "year": "exact",
    "matches": "exact",
    "sigma": "measurement"
   }
  },
  {
   "name": "gauntlet-row",
   "source": "report.py:240-248",
   "exact_line": true,
   "regex": "\\| (?P<test>[a-z][a-z_0-9]*) \\| (?P<status>[A-Z_]+(?: \\([a-z_]+\\))?) \\| (?P<severity>[a-z]+) \\| (?P<message>.*) \\|",
   "groups": {
    "test": "exact",
    "status": "exact",
    "severity": "exact",
    "message": "exact"
   }
  }
 ],
