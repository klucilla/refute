@{
    # Role capability of the JEA endpoint RefuteVm (scripts/vm/README.md). The
    # connecting account sees these two functions, plus the default helper commands
    # that SessionType RestrictedRemoteServer keeps (Clear-Host, Exit-PSSession,
    # Get-Command, Get-FormatData, Get-Help, Measure-Object, Out-Default,
    # Select-Object). The session runs in NoLanguage mode: literal arguments only, no
    # script block or expression. The functions take no path and no VM name.
    #
    # The module is imported by the absolute path of its installed manifest, in a folder
    # only administrators can write (Register-RefuteVmEndpoint.ps1 installs it there,
    # with no version subfolder, and checks this path). That path pins the copy, so no
    # other module named RefuteVm can be imported in its place. No RequiredVersion,
    # ModuleVersion, MaximumVersion or GUID: with any of them PowerShell resolves the
    # module by calling Get-Module inside the restricted session, which does not have it,
    # and the session cannot open ("The term 'Get-Module' is not recognized", observed by
    # the maintainer on 2026-10-16). With a name or a path only, it runs Import-Module
    # directly (ProcessModulesToImport in
    # https://github.com/PowerShell/PowerShell/blob/master/src/System.Management.Automation/engine/InitialSessionState.cs,
    # accessed 2026-10-16). tests/test_vm_scripts.py refuses version keys in every .psrc.
    #
    # A RestrictedRemoteServer session holds the core cmdlets (as private commands) but not
    # the script functions of Microsoft.PowerShell.Utility (Import-PowerShellDataFile,
    # Get-FileHash) nor the Hyper-V cmdlets, which the module's functions call ("The term
    # 'Import-PowerShellDataFile' is not recognized", observed by the maintainer on
    # 2026-10-16). Two more imports, before RefuteVm, each by the absolute path of its
    # manifest in System32, so that no other folder of the module path is searched:
    #   - Microsoft.PowerShell.Utility, in $PSHOME: by name it is taken as already loaded
    #     (its cmdlets are) and its functions do not come; by the path they do
    #     (tests/vm/jea_commands.ps1);
    #   - Hyper-V, in its version subfolder (Hyper-V\2.0.0.0 on Windows 10, 11 and Server
    #     2025). Its manifest loads the cmdlets from Microsoft.HyperV.PowerShell.Cmdlets.dll
    #     in the global assembly cache. The registration requires this manifest to be the
    #     one the host has, and only administrators able to write to the module folders and
    #     the assembly folder.
    # The commands they bring are private: the functions of RefuteVm call them, the
    # connecting account does not see them. VisibleFunctions below is the only list of
    # visible commands, and tests/test_vm_jea_integration.py checks on a real endpoint that
    # the session shows exactly these two functions and the eight helper commands.
    GUID             = '6f1c6a0e-5b2d-4f4e-9d1a-3c7e2b8a9f41'
    Description      = 'Refute VM operator: status and one approved operation per call.'
    ModulesToImport  = @(
        'C:\Windows\System32\WindowsPowerShell\v1.0\Modules\Microsoft.PowerShell.Utility\Microsoft.PowerShell.Utility.psd1',
        'C:\Windows\System32\WindowsPowerShell\v1.0\Modules\Hyper-V\2.0.0.0\Hyper-V.psd1',
        'C:\Program Files\WindowsPowerShell\Modules\RefuteVm\RefuteVm.psd1'
    )
    VisibleFunctions = @('Get-RefuteVmStatus', 'Invoke-RefuteVmOperation')
}
