#cloud-config
# Autoinstall configuration of the Refute VM, read by the Ubuntu Server 26.04.1 live
# installer from the CIDATA seed (NoCloud). Keys:
# https://canonical-subiquity.readthedocs-hosted.com/en/latest/reference/autoinstall-reference.html
# (retrieved 2026-10-15 and 2026-10-17). The installer still asks "Continue with
# autoinstall?" on the console; the maintainer answers it.
#
# Phase 2 (2026-10-17, the maintainer's decisions; docs/validation/v0.3/wp6-results/
# phase2-network-design.md): the network is in the seed, since the installer writes it to
# the installed system ("applied during installation as well as in the installed
# system"). The adapter stays disconnected during the whole installation.
# - one interface, matched by the kernel driver of Hyper-V's synthetic adapter
#   (hv_netvsc; matching on the driver is "only supported with networkd", the default),
#   with the static address 10.231.71.2/29, no gateway, no DNS server, no DHCP, no
#   router advertisements and no link-local addresses (netplan: "If the field is defined
#   but configured as an empty set, IPv6 link-local addresses are disabled as well as IPv4
#   link-local addresses"); IPv6 is also denied at the port, outside the guest;
# - apt and snapd use the allowlist proxy 10.231.71.3:3128 (autoinstall `proxy`);
# - systemd-networkd-wait-online is masked: with a static address and no carrier the boot
#   waited about 2 minutes on it (jea-registration.md, section 20).
autoinstall:
  version: 1
  interactive-sections: []
  refresh-installer:
    update: false
  locale: en_US.UTF-8
  keyboard:
    layout: us
  timezone: Etc/UTC
  network:
    version: 2
    ethernets:
      vmnet:
        match:
          driver: hv_netvsc
        addresses: [10.231.71.2/29]
        dhcp4: false
        dhcp6: false
        accept-ra: false
        link-local: []
  proxy: http://10.231.71.3:3128
  apt:
    fallback: offline-install
  storage:
    layout:
      name: direct
  ssh:
    install-server: true
    allow-pw: false
  updates: security
  late-commands:
    - curtin in-target -- systemctl mask systemd-networkd-wait-online.service
  shutdown: poweroff
  user-data:
    hostname: refute-vm
    disable_root: true
    ssh_pwauth: false
    users:
      - name: refute
        shell: /bin/bash
        lock_passwd: true
        sudo: "ALL=(ALL) NOPASSWD:ALL"
        ssh_authorized_keys:
          - {{SSH_PUBLIC_KEY}}
