# Force LF line endings in the working tree on every platform, so that file
# hashes (code hash, attachment hashes) are identical on Windows and Linux.
* text=auto eol=lf
*.fits binary
*.png binary
*.zip binary
*.npz binary
calibration/v0.2/audit/** -text
docs/validation/v0.2.1/pre-document-runs/** -text
docs/validation/v0.2.1/baseline/** -text
docs/validation/v0.2.1/population/** -text
# the sealed dossiers of v0.3, published byte for byte (wp3-dossier-provenance-acceptance.md)
calibration/v0.3/main/dossiers/*/dossier/** -text
